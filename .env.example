OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
ENABLE_VISION_FALLBACK=true

# Performance. The defaults are what the README's numbers were measured with; these
# are here for tuning against a particular account's rate limits and a particular
# shape of document.
# CHUNK_CONCURRENCY=4     # model calls in flight at once
# CHUNK_LINE_LIMIT=80     # source lines per call — lower if long tables come back short
# CHUNK_CHAR_LIMIT=40000  # source characters per call — rarely the binding limit
